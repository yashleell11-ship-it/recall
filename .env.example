# Copy to .env and fill in. .env is gitignored — never commit the real key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
RECALL_MODEL=deepseek-chat
RECALL_DB=recall.db
RECALL_MAX_COST_USD=2.0
# Verify current DeepSeek pricing before trusting these; they only affect estimates.
RECALL_PRICE_INPUT_PER_MTOK=0.27
RECALL_PRICE_OUTPUT_PER_MTOK=1.10

# The session cookie is Secure by default, which is correct in production
# (Caddy terminates TLS) but means a browser silently DROPS it over plain
# http. Set this to 0 for local dev, and never in production.
#   RECALL_COOKIE_SECURE=0
# Also browse local dev at http://127.0.0.1:3210, not http://localhost:3210 —
# with the API on 127.0.0.1:8077, using "localhost" for the page makes the
# request cross-site and SameSite=Lax withholds the cookie.
